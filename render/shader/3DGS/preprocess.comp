// 球谐函数常数定义
#define SH_C0 0.28209479177387814
const float SH_C1 = 0.4886025119029199;
const float SH_C2[5] = float[](
        1.0925484305920792,
        -1.0925484305920792,
        0.31539156525252005,
        -1.0925484305920792,
        0.5462742152960396
);
const float SH_C3[7] = float[](
        -0.5900435899266435,
        2.890611442640554,
        -0.4570457994644658,
        0.3731763325901154,
        -0.4570457994644658,
        1.445305721320277,
        -0.5900435899266435
);

const int BLOCK_X = 16;
const int BLOCK_Y = 16;

// ==========================================================
// 1. 定义 Buffer Reference 物理布局（完全等价于旧版 std430 结构）
// ==========================================================
layout(buffer_reference, scalar) readonly  buffer GaussianPositions_Ref { vec4  positions[]; };
layout(buffer_reference, scalar) readonly  buffer GaussianScales_Ref    { vec4  scales[]; };
layout(buffer_reference, scalar) readonly  buffer GaussianRotations_Ref { vec4  rotations[]; };
layout(buffer_reference, scalar) readonly  buffer GaussianOpacities_Ref { float opacities[]; };
layout(buffer_reference, scalar) readonly  buffer GaussianSH_Ref        { float sh_coefficients[]; };

layout(buffer_reference, scalar) writeonly buffer OutputRadii_Ref       { int   radius[]; };
layout(buffer_reference, scalar) writeonly buffer OutputDepth_Ref       { float depth[]; };
layout(buffer_reference, scalar) writeonly buffer OutputRGB_Ref         { vec4  rgb[]; };
layout(buffer_reference, scalar) writeonly buffer OutputConicOpacity_Ref{ vec4  conicOpacity[]; };
layout(buffer_reference, scalar) writeonly buffer OutputPointsXY_Ref    { vec2  pointsXY[]; };
layout(buffer_reference, scalar) writeonly buffer OutputTilesTouched_Ref{ uint  tilesTouched[]; };
layout(buffer_reference, scalar) writeonly buffer BoundingBox_Ref       { uvec4 bbox[]; };

// ==========================================================
// 2. 通过 Push Constant 一口气上传原本需要 12 个 Binding 的地址
// ==========================================================
layout(push_constant, scalar) uniform PushConstants {
    uint64_t positions_address;
    uint64_t scales_address;
    uint64_t rotations_address;
    uint64_t opacities_address;
    uint64_t sh_coefficients_address;

    uint64_t radius_address;
    uint64_t depth_address;
    uint64_t rgb_address;
    uint64_t conicOpacity_address;
    uint64_t pointsXY_address;
    uint64_t tilesTouched_address;
    uint64_t bbox_address;

    float near;
    float far;
    uint gaussianCount;
    uint culling;
    int shDegree;

} pc;

// ==========================================================
// 3. 声明全局作用域指针变量（保留原函数内部公式隐式读取，免改函数签名）
// ==========================================================
GaussianPositions_Ref  positions;
GaussianScales_Ref     scales;
GaussianRotations_Ref  rotations;
GaussianOpacities_Ref  opacities;
GaussianSH_Ref         sh_coefficients;

OutputRadii_Ref        radius;
OutputDepth_Ref        depth;
OutputRGB_Ref          rgb;
OutputConicOpacity_Ref conicOpacity;
OutputPointsXY_Ref     pointsXY;
OutputTilesTouched_Ref tilesTouched;
BoundingBox_Ref        bbox;

// ==========================================================
// 4. 核心功能函数（原汁原味复原公式，完全无痛迁移）
// ==========================================================
int getSHCoeffCount(int degree) {
    if (degree == 0) return 1;
    if (degree == 1) return 4;
    if (degree == 2) return 9;
    if (degree == 3) return 16;
    return 1;
}



float ndc2Pix(float ndc, int size) {
    return ((ndc + 1.0) * size - 1.0) * 0.5;
}

bool inFrustum(int idx, out vec3 pView) {
    vec4 pos = positions.positions[idx];
    pView = mat3(view) * pos.xyz + view[3].xyz;

    // Near plane culling
    //if (pView.z <= 0.01) return false;

    if (pView.z >= -1 * pc.near) return false;
    if (pView.z < -1 * pc.far) return false;
    // Frustum culling (simplified)
    vec4 pClip = projection * vec4(pView, 1.0);
    return abs(pClip.x) <= pClip.w && abs(pClip.y) <= pClip.w;
}

vec3 computeColorFromSH(int idx) {
    vec3 pos = positions.positions[idx].xyz;
    vec3 dir = normalize(pos - viewPos.xyz);
    //dir.z = -dir.z;

    // Get base index for this Gaussian's SH coefficients
    int shBase = idx * getSHCoeffCount(pc.shDegree);

    // SH degree 0 - sh[0]
    vec3 result = SH_C0 * vec3(
            sh_coefficients.sh_coefficients[shBase * 3 + 0],
            sh_coefficients.sh_coefficients[shBase * 3 + 1],
            sh_coefficients.sh_coefficients[shBase * 3 + 2]
    );

    if (pc.shDegree > 0) {
        float x = dir.x;
        float y = dir.y;
        float z = dir.z;

        // SH degree 1 - sh[1], sh[2], sh[3]
        result = result - SH_C1 * y * vec3(
                sh_coefficients.sh_coefficients[(shBase + 1) * 3 + 0],
                sh_coefficients.sh_coefficients[(shBase + 1) * 3 + 1],
                sh_coefficients.sh_coefficients[(shBase + 1) * 3 + 2]
        ) + SH_C1 * z * vec3(
                sh_coefficients.sh_coefficients[(shBase + 2) * 3 + 0],
                sh_coefficients.sh_coefficients[(shBase + 2) * 3 + 1],
                sh_coefficients.sh_coefficients[(shBase + 2) * 3 + 2]
        ) - SH_C1 * x * vec3(
                sh_coefficients.sh_coefficients[(shBase + 3) * 3 + 0],
                sh_coefficients.sh_coefficients[(shBase + 3) * 3 + 1],
                sh_coefficients.sh_coefficients[(shBase + 3) * 3 + 2]
        );

        if (pc.shDegree > 1) {
            float xx = x * x, yy = y * y, zz = z * z;
            float xy = x * y, yz = y * z, xz = x * z;

            // SH degree 2 - sh[4] through sh[8]
            result = result +
            SH_C2[0] * xy * vec3(
                    sh_coefficients.sh_coefficients[(shBase + 4) * 3 + 0],
                    sh_coefficients.sh_coefficients[(shBase + 4) * 3 + 1],
                    sh_coefficients.sh_coefficients[(shBase + 4) * 3 + 2]
            ) +
            SH_C2[1] * yz * vec3(
                    sh_coefficients.sh_coefficients[(shBase + 5) * 3 + 0],
                    sh_coefficients.sh_coefficients[(shBase + 5) * 3 + 1],
                    sh_coefficients.sh_coefficients[(shBase + 5) * 3 + 2]
            ) +
            SH_C2[2] * (2.0 * zz - xx - yy) * vec3(
                    sh_coefficients.sh_coefficients[(shBase + 6) * 3 + 0],
                    sh_coefficients.sh_coefficients[(shBase + 6) * 3 + 1],
                    sh_coefficients.sh_coefficients[(shBase + 6) * 3 + 2]
            ) +
            SH_C2[3] * xz * vec3(
                    sh_coefficients.sh_coefficients[(shBase + 7) * 3 + 0],
                    sh_coefficients.sh_coefficients[(shBase + 7) * 3 + 1],
                    sh_coefficients.sh_coefficients[(shBase + 7) * 3 + 2]
            ) +
            SH_C2[4] * (xx - yy) * vec3(
                    sh_coefficients.sh_coefficients[(shBase + 8) * 3 + 0],
                    sh_coefficients.sh_coefficients[(shBase + 8) * 3 + 1],
                    sh_coefficients.sh_coefficients[(shBase + 8) * 3 + 2]
            );

            if (pc.shDegree > 2) {
                // SH degree 3 - sh[9] through sh[15]
                result = result +
                SH_C3[0] * y * (3.0 * xx - yy) * vec3(
                        sh_coefficients.sh_coefficients[(shBase + 9) * 3 + 0],
                        sh_coefficients.sh_coefficients[(shBase + 9) * 3 + 1],
                        sh_coefficients.sh_coefficients[(shBase + 9) * 3 + 2]
                ) +
                SH_C3[1] * xy * z * vec3(
                        sh_coefficients.sh_coefficients[(shBase + 10) * 3 + 0],
                        sh_coefficients.sh_coefficients[(shBase + 10) * 3 + 1],
                        sh_coefficients.sh_coefficients[(shBase + 10) * 3 + 2]
                ) +
                SH_C3[2] * y * (4.0 * zz - xx - yy) * vec3(
                        sh_coefficients.sh_coefficients[(shBase + 11) * 3 + 0],
                        sh_coefficients.sh_coefficients[(shBase + 11) * 3 + 1],
                        sh_coefficients.sh_coefficients[(shBase + 11) * 3 + 2]
                ) +
                SH_C3[3] * z * (2.0 * zz - 3.0 * xx - 3.0 * yy) * vec3(
                        sh_coefficients.sh_coefficients[(shBase + 12) * 3 + 0],
                        sh_coefficients.sh_coefficients[(shBase + 12) * 3 + 1],
                        sh_coefficients.sh_coefficients[(shBase + 12) * 3 + 2]
                ) +
                SH_C3[4] * x * (4.0 * zz - xx - yy) * vec3(
                        sh_coefficients.sh_coefficients[(shBase + 13) * 3 + 0],
                        sh_coefficients.sh_coefficients[(shBase + 13) * 3 + 1],
                        sh_coefficients.sh_coefficients[(shBase + 13) * 3 + 2]
                ) +
                SH_C3[5] * z * (xx - yy) * vec3(
                        sh_coefficients.sh_coefficients[(shBase + 14) * 3 + 0],
                        sh_coefficients.sh_coefficients[(shBase + 14) * 3 + 1],
                        sh_coefficients.sh_coefficients[(shBase + 14) * 3 + 2]
                ) +
                SH_C3[6] * x * (xx - 3.0 * yy) * vec3(
                        sh_coefficients.sh_coefficients[(shBase + 15) * 3 + 0],
                        sh_coefficients.sh_coefficients[(shBase + 15) * 3 + 1],
                        sh_coefficients.sh_coefficients[(shBase + 15) * 3 + 2]
                );
            }
        }
    }

    result += 0.5;

    return max(result, vec3(0.0));
}

vec3 computeCov2D(vec3 mean, float cov3D_data[6], float tan_fovx, float tan_fovy, float focal_x, float focal_y) {
    // Transform to view space
    vec3 t = mean;

    // Clamp to frustum
    float limx = 1.3 * tan_fovx;
    float limy = 1.3 * tan_fovy;
    float txtz = t.x / t.z;
    float tytz = t.y / t.z;
    t.x = clamp(txtz, -limx, limx) * t.z;
    t.y = clamp(tytz, -limy, limy) * t.z;

    // Jacobian matrix
    mat3 J = mat3(
            focal_x / t.z, 0.0, -(focal_x * t.x) / (t.z * t.z),
            0.0, focal_y / t.z, -(focal_y * t.y) / (t.z * t.z),
            0.0, 0.0, 0.0
    );

    // View matrix (upper 3x3)
    mat3 W = transpose(mat3(view));
    mat3 T = W * J;

    mat3 Vrk = mat3(
            cov3D_data[0], cov3D_data[1], cov3D_data[2],  // [xx, xy, xz]
            cov3D_data[1], cov3D_data[3], cov3D_data[4],  // [xy, yy, yz]
            cov3D_data[2], cov3D_data[4], cov3D_data[5]   // [xz, yz, zz]
    );

    mat3 cov = transpose(T) * Vrk * T;

    // Low-pass filter
    cov[0][0] += 0.3;
    cov[1][1] += 0.3;

    return vec3(cov[0][0], cov[0][1], cov[1][1]);
}

void computeCov3D(int idx, float scaleModifier, out float cov3D_out[6]) {
    vec3 scale = scales.scales[idx].xyz;
    vec4 rot = rotations.rotations[idx];

    // Scaling matrix
    mat3 S = mat3(
            scaleModifier * scale.x, 0.0, 0.0,
            0.0, scaleModifier * scale.y, 0.0,
            0.0, 0.0, scaleModifier * scale.z
    );

    // Normalize quaternion and compute rotation matrix
    vec4 q = normalize(rot);
    float r = q.x, x = q.y, y = q.z, z = q.w;

    mat3 R = mat3(
            1.0 - 2.0 * (y * y + z * z), 2.0 * (x * y - r * z), 2.0 * (x * z + r * y),
            2.0 * (x * y + r * z), 1.0 - 2.0 * (x * x + z * z), 2.0 * (y * z - r * x),
            2.0 * (x * z - r * y), 2.0 * (y * z + r * x), 1.0 - 2.0 * (x * x + y * y)
    );

    mat3 M = S * R;
    mat3 Sigma = transpose(M) * M;

    // Store symmetric matrix (upper triangle)
    cov3D_out[0] = Sigma[0][0];
    cov3D_out[1] = Sigma[0][1];
    cov3D_out[2] = Sigma[0][2];
    cov3D_out[3] = Sigma[1][1];
    cov3D_out[4] = Sigma[1][2];
    cov3D_out[5] = Sigma[2][2];
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    // 这里是一维的数据 element vertex 1244819 是根据 .ply 的文件的数量来进行处理的
    //  uint32_t groupX = (_numGaussians + 255) / 256;
    //  vkCmdDispatch(commandBuffer, groupX, 1, 1);


    float tan_fovx = abs(1.0 / projection[0][0]);
    float tan_fovy = abs(1.0 / projection[1][1]);

    // 2. 根据当前的屏幕分辨率计算像素焦距 focal_x 和 focal_y
    float focal_x = float(screen_size.x) / (2.0 * tan_fovx);
    float focal_y = float(screen_size.y) / (2.0 * tan_fovy);


    if (idx >= pc.gaussianCount) return;
    // 将 64 位整数物理地址从这里赋予全局变量指针以驱动执行
    positions = GaussianPositions_Ref(pc.positions_address);
    scales = GaussianScales_Ref(pc.scales_address);
    rotations = GaussianRotations_Ref(pc.rotations_address);
    opacities = GaussianOpacities_Ref(pc.opacities_address);
    sh_coefficients = GaussianSH_Ref(pc.sh_coefficients_address);
    radius = OutputRadii_Ref(pc.radius_address);
    depth = OutputDepth_Ref(pc.depth_address);
    rgb = OutputRGB_Ref(pc.rgb_address);
    conicOpacity = OutputConicOpacity_Ref(pc.conicOpacity_address);
    pointsXY = OutputPointsXY_Ref(pc.pointsXY_address);
    tilesTouched = OutputTilesTouched_Ref(pc.tilesTouched_address);
    bbox = BoundingBox_Ref(pc.bbox_address);
    int gridX = (int(screen_size.x) + BLOCK_X - 1) / BLOCK_X;
    int gridY = (int(screen_size.y) + BLOCK_Y - 1) / BLOCK_Y;


    //    if (idx < 10) { vec3 scale = scales.scales[idx].xyz;
    //        radius.radius[idx] = int(12);// See actual scale values
    //    }


    // Initialize outputs
    radius.radius[idx] = 0;
    tilesTouched.tilesTouched[idx] = 0;
    depth.depth[idx] = 0.0;

    // Frustum culling
    vec3 pView;
    bool inFrust = inFrustum(int(idx), pView);
    if (pc.culling == 1){
        if (!inFrust) return;
    }

    // Transform to clip space
    vec4 pOrig = positions.positions[idx];
    vec4 pHom = projection * view * pOrig;
    float pW = 1.0 / (pHom.w + 0.0000001);
    vec3 pProj = pHom.xyz * pW;

    // Compute 3D covariance
    float cov3D_data[6];
    computeCov3D(int(idx), 1.0, cov3D_data);

    // Compute 2D covariance
    vec3 cov2D = computeCov2D(pView, cov3D_data, tan_fovx, tan_fovy, focal_x, focal_y);

    // Invert covariance (EWA algorithm)
    float det = cov2D.x * cov2D.z - cov2D.y * cov2D.y;
    if (det == 0.0) return;

    float detInv = 1.0 / det;
    vec3 conic = vec3(cov2D.z * detInv, -cov2D.y * detInv, cov2D.x * detInv);

    // Compute extent and bounding rectangle
    float mid = 0.5 * (cov2D.x + cov2D.z);
    float lambda1 = mid + sqrt(max(0.1, mid * mid - det));
    float lambda2 = mid - sqrt(max(0.1, mid * mid - det));
    float myRadius = ceil(3.0 * sqrt(max(lambda1, lambda2)));
    vec2 pointImage = vec2(
            ndc2Pix(pProj.x, int(screen_size.x)),
            ndc2Pix(pProj.y, int(screen_size.y))
    );

    ivec2 rectMin = ivec2(
            min(gridX, max(0, int((pointImage.x - myRadius) / BLOCK_X))),
            min(gridY, max(0, int((pointImage.y - myRadius) / BLOCK_Y)))
    );

    ivec2 rectMax = ivec2(
            min(gridX, max(0, int((pointImage.x + myRadius + BLOCK_X - 1) / BLOCK_X))),
            min(gridY, max(0, int((pointImage.y + myRadius + BLOCK_Y - 1) / BLOCK_Y)))
    );

    bbox.bbox[idx] = uvec4(rectMin.x, rectMin.y, rectMax.x, rectMax.y);


    if ((rectMax.x - rectMin.x) * (rectMax.y - rectMin.y) == 0) return;

    // 从球谐系数计算视图方向颜色
    // Compute color from spherical harmonics
    vec3 color = computeColorFromSH(int(idx)); // 问题，这里为什么要计算颜色？
    // 数据持久化写入内存物理指针地址
    depth.depth[idx] = -pView.z;
    radius.radius[idx] = int(myRadius);
    pointsXY.pointsXY[idx] = pointImage;
    conicOpacity.conicOpacity[idx] = vec4(conic, opacities.opacities[idx]);
    tilesTouched.tilesTouched[idx] = uint((rectMax.y - rectMin.y) * (rectMax.x - rectMin.x));
    // 这里来看的话是面积

    // Store RGB
    // 存储 RGB 数据
    rgb.rgb[idx].xyz = color;
}


