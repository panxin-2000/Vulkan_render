#version 450
// 假设你使用的是标准的 16x16 线程组，可根据实际运行效率调整
layout(local_size_x = 16, local_size_y = 16) in;

// --- 对应原本的材质参数 parameters 声明 ---
layout(binding = 0) uniform sampler2D materialParams_source;

// 目标输出图像（降采样后的低分辨率纹理）
layout(rgba16f, binding = 1) writeonly uniform image2D out_texture;

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;

    // 获取目标图像尺寸（即当前降采样层的分辨率）
    ivec2 texSize = imageSize(out_texture);
    uint width = uint(texSize.x);
    uint height = uint(texSize.y);

    // 越界检查
    if (x >= width || y >= height) {
        return;
    }

    // 【核心替换】将原本的 variable_vertex.xy 替换为当前像素中心的归一化 UV 坐标
    highp vec2 uv = (vec2(x, y) + vec2(0.5)) / vec2(width, height);

    // 获取输入纹理（上一层高分辨率纹理）的纹素大小（Texel Size）
    highp vec2 size = vec2(1.0) / vec2(textureSize(materialParams_source, 0));

    // --- 原算法中的权重与缩放参数计算 ---
    float o  = 1.5 + 0.261629;
    float wa = 7.46602 / 32.0;
    float wb = 1.0 - wa * 2.0;
    float wab = wa * wb;
    float waa = wa * wa;
    float wbb = wb * wb;

    // 应用精心计算出的硬件双线性插值偏移尺寸
    size *= o;

    // --- 9 次双线性采样逻辑 ---
    vec3 c  = textureLod(materialParams_source, uv + vec2(0.0)            , 0.0).rgb; // 中心
    vec3 l  = textureLod(materialParams_source, uv + vec2(-size.x,    0.0), 0.0).rgb; // 左
    vec3 r  = textureLod(materialParams_source, uv + vec2( size.x,    0.0), 0.0).rgb; // 右
    vec3 b  = textureLod(materialParams_source, uv + vec2(    0.0,-size.y), 0.0).rgb; // 下
    vec3 t  = textureLod(materialParams_source, uv + vec2(    0.0, size.y), 0.0).rgb; // 上
    vec3 lb = textureLod(materialParams_source, uv + vec2(-size.x,-size.y), 0.0).rgb; // 左下
    vec3 rb = textureLod(materialParams_source, uv + vec2( size.x,-size.y), 0.0).rgb; // 右下
    vec3 lt = textureLod(materialParams_source, uv + vec2(-size.x, size.y), 0.0).rgb; // 左上
    vec3 rt = textureLod(materialParams_source, uv + vec2( size.x, size.y), 0.0).rgb; // 右上

    // --- 最终的滤波器权重组合 ---
    vec3 finalColor = (c * wbb +
    (l * wab +
    (r * wab +
    (b * wab +
    (t * wab +
    (lb * waa +
    (rb * waa +
    (lt * waa +
    (rt * waa)))))))));

    // 将计算出的降采样颜色写入目标纹理
    imageStore(out_texture, ivec2(x, y), vec4(finalColor, 1.0));
}
