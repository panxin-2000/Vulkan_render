#version 450
#extension GL_GOOGLE_include_directive: enable
#include "global_shader_common.glsl"

layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// ==========================================
// 1. 外部参数输入 (通过 Push Constant)
// ==========================================
layout (push_constant) uniform PushConstant {
    float u_Amount;    // 锐化强度 (通常在 0.5 到 2.0 之间)
    float u_Threshold; // 锐化阈值 (0.0~1.0)：用于过滤微小噪声，防止噪点被放大
} pcs;

// 假设绑定的图像：输入原图与输出锐化图
// layout(binding = 0, rgba8) uniform readonly image2D input_Image;
// layout(binding = 1, rgba8) uniform writeonly image2D output_Image;

void main()
{
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;

    ivec2 texSize = imageSize(input_Image);
    if (x >= uint(texSize.x) || y >= uint(texSize.y)) {
        return;
    }

    ivec2 pixel_coords = ivec2(gl_GlobalInvocationID.xy);

    // ==========================================
    // 2. 读取中心原始数据
    // ==========================================
    vec4 centerColor = imageLoad(input_Image, pixel_coords);

    // 5x5 标准高斯核一维分布 (归一化权重)
    const float gauss1D[5] = float[](0.0625, 0.25, 0.375, 0.25, 0.0625);

    vec3 blurColor = vec3(0.0);
    float totalWeight = 0.0;

    // ==========================================
    // 3. 数据处理：构建低频（模糊）图像
    // ==========================================
    for (int i = -2; i <= 2; i++)
    {
        for (int j = -2; j <= 2; j++)
        {
            ivec2 neighbor_coords = pixel_coords + ivec2(i, j);
            neighbor_coords = clamp(neighbor_coords, ivec2(0), texSize - ivec2(1));

            vec3 neighborColor = imageLoad(input_Image, neighbor_coords).rgb;

            // 计算 2D 高斯空间权重
            float weight = gauss1D[i + 2] * gauss1D[j + 2];

            blurColor += neighborColor * weight;
            totalWeight += weight;
        }
    }
    blurColor /= totalWeight; // 得到纯粹的低频数据

    // ==========================================
    // 4. 数据提取与加工：计算高频并应用锐化
    // ==========================================
    vec3 rawRGB = centerColor.rgb;

    // 提取高频细节：原图 - 低频图
    vec3 highPass = rawRGB - blurColor;

    // 【关键工程优化】阈值控制 (Threshold)
    // 转化为亮度(Luminance)来评估细节强度，避免对平坦区域的微小噪声(如画面颗粒)进行错误锐化
    float highPassLuma = dot(abs(highPass), vec3(0.2126, 0.7152, 0.0722));

    vec3 sharpenedRGB = rawRGB;

    // 只有当高频信号的强度大于设定的阈值时，才进行对比度放大处理
    if (highPassLuma > pcs.u_Threshold)
    {
        // 核心公式：Sharpened = Raw + Amount * HighPass
        sharpenedRGB += pcs.u_Amount * highPass;
    }

    // 数据的安全截断，防止色彩溢出 [0.0, 1.0]
    sharpenedRGB = clamp(sharpenedRGB, vec3(0.0), vec3(1.0));

    // ==========================================
    // 5. 数据输出
    // ==========================================
    // 保持原图的 Alpha 通道不变
    imageStore(output_Image, pixel_coords, vec4(sharpenedRGB, centerColor.a));
}
