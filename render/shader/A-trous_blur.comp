#version 450
#extension GL_GOOGLE_include_directive: enable
#include "global_shader_common.glsl"

layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// ==========================================
// 引入 Uniform 传参，用于控制多 Pass 的步长
// ==========================================
layout (push_constant) uniform PushConstant {
    int u_StepSize; // 从 CPU 传入当前 Pass 的步长：1, 2, 4, 8 ...
} pc;



void main()
{
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;

    ivec2 image_size = imageSize(global_Blur_SSAO_compute_write);
    if (x >= uint(image_size.x) || y >= uint(image_size.y)) {
        return;
    }

    ivec2 pixel_coords = ivec2(gl_GlobalInvocationID.xy);
    int stepSize = pcs.u_StepSize; // 获取当前步长

    // ==========================================
    // 1. 获取中心像素的 Raw AO 和 深度
    // ==========================================
    float centerAO = imageLoad(global_SSAO_compute_write, pixel_coords).r;
    float centerDepth = texelFetch(global_depth, pixel_coords, 0).r;

    // À-Trous 标准核半径固定为 2 (即 5x5 的核)
    const int blurRange = 2;
    float totalAO = 0.0;
    float totalWeight = 0.0;

    // 保留你原有的深度阈值
    const float depthThreshold = 0.05;

    // ==========================================
    // 2. 5x5 À-Trous 带孔循环
    // ==========================================
    for (int offset_x = -blurRange; offset_x <= blurRange; offset_x++)
    {
        for (int offset_y = -blurRange; offset_y <= blurRange; offset_y++)
        {
            // 【核心修改】实际采样坐标 = 当前坐标 + (循环偏移 * 步长)
            ivec2 offset = ivec2(offset_x, offset_y) * stepSize;
            ivec2 neighbor_coords = pixel_coords + offset;

            // 边界截断处理
            neighbor_coords = clamp(neighbor_coords, ivec2(0), image_size - ivec2(1));

            // 读取邻域像素数据
            float neighborAO = imageLoad(global_SSAO_compute_write, neighbor_coords).r;
            float neighborDepth = texelFetch(global_depth, neighbor_coords, 0).r;

            // ==========================================
            // 3. 严格保留你原有的双边权重计算公式
            // ==========================================
            // 空间距离高斯权重（这里基于循环的 offset_x/y 计算，确保核的形态不随步长拉伸而改变）
            float spatialWeight = (-float(offset_x * offset_x + offset_y * offset_y) / (2.0 * float(blurRange * blurRange)));
            //
            // 本质是小波变换（Wavelet Transform）


            // 深度相似度权重：严格保持原样
            float depthDiff = abs(centerDepth - neighborDepth);
            float depthWeight = exp(-depthDiff / depthThreshold);

            // 最终复合权重
            float weight = spatialWeight * depthWeight;

            // 累加
            totalAO += neighborAO * weight;
            totalWeight += weight;
        }
    }

    // 防止分母为 0
    float finalAO = totalAO / (totalWeight + 0.0001);

    imageStore(global_Blur_SSAO_compute_write, pixel_coords, vec4(finalAO, 0.0, 0.0, 0.0));
}
