#version 450

#define PNANOVDB_GLSL

#extension GL_GOOGLE_include_directive: enable
#extension GL_EXT_buffer_reference: require
#extension GL_EXT_scalar_block_layout: require
#extension GL_ARB_gpu_shader_int64: require

#include "global_shader_common.glsl"

layout (buffer_reference, scalar) readonly buffer AABB_boxes {
    AABB_box aabb_box[];
};

layout (buffer_reference, scalar) buffer IndirectCommands {
    VkDrawIndexedIndirectCommand command[];
};

struct hiz_cull_para{
    uint hiz_min_lod;
    uint hiz_max_lod;
};


layout (push_constant) uniform PushConstant {
    Frustum frustum;
    uint64_t AABB_boxesAddress;
    uint64_t IndirectCommandsAddress;
    uint command_size;
    hiz_cull_para para;
} push_constant;

/**
*  这里给出的是 AABB 的包围盒, 依次读取中心的 深度 和 四个角的深度
*   需要与该包围盒（AABB）投影到屏幕之后的“最近点”的深度值进行比较
*  if (boxClosestDepth < hzbDepth) {
*    return; // 遮挡剔除，不进行渲染
*  }
**/
float sampleHZB(sampler2D uHZB, vec4 aabbUV){

    ivec2 image_size = textureSize(uHZB, 0);

    float width = (aabbUV.z - aabbUV.x) * float(image_size.x);
    float height = (aabbUV.w - aabbUV.y) * float(image_size.y);
    float level = floor(log2(max(width, height)));

    level = max(level, 0.0);
    vec2 uvCenter = (aabbUV.xy + aabbUV.zw) * 0.5;
    float d = textureLod(uHZB, uvCenter, level).r;

    vec2 uv0 = vec2(aabbUV.x, aabbUV.y);
    vec2 uv1 = vec2(aabbUV.z, aabbUV.y);
    vec2 uv2 = vec2(aabbUV.z, aabbUV.w);
    vec2 uv3 = vec2(aabbUV.x, aabbUV.w);

    // uHZB 其实如果因为 视角转动的问题,会出现 物体忽然出现 又忽然消失的情况
    // 另一个可能的优化是 , 利用这一帧的视角,重新绘制上一帧 出现的全部物体的 深度图
    // 另一个可能的优化是 , 重投影 HZB（Reprojection HZB）,

    d = max(d, textureLod(uHZB, uv0, level).r);
    d = max(d, textureLod(uHZB, uv1, level).r);
    d = max(d, textureLod(uHZB, uv2, level).r);
    d = max(d, textureLod(uHZB, uv3, level).r);

    return d;
}


vec4 getScreenAABBUV(AABB_box box, inout float boxClosestDepth) {
    // 1. 计算 3D 空间下的最小点和最大点
    vec3 c = box.centroid_points.xyz;
    vec3 e = box.direction_intervals.xyz;
    vec3 boxMin = c - e;
    vec3 boxMax = c + e;

    // 2. 构造 AABB 的 8 个世界/局部空间顶点
    vec3 vertices[8];
    vertices[0] = vec3(boxMin.x, boxMin.y, boxMin.z);
    vertices[1] = vec3(boxMax.x, boxMin.y, boxMin.z);
    vertices[2] = vec3(boxMin.x, boxMax.y, boxMin.z);
    vertices[3] = vec3(boxMax.x, boxMax.y, boxMin.z);
    vertices[4] = vec3(boxMin.x, boxMin.y, boxMax.z);
    vertices[5] = vec3(boxMax.x, boxMin.y, boxMax.z);
    vertices[6] = vec3(boxMin.x, boxMax.y, boxMax.z);
    vertices[7] = vec3(boxMax.x, boxMax.y, boxMax.z);

    // 初始化 UV 的极值
    // 使用大数值初始化 min，小数值初始化 max 方便后续用 min/max 函数迭代
    vec2 minUV = vec2(1.0);
    vec2 maxUV = vec2(0.0);

    // 3. 遍历 8 个顶点进行投影计算
    for (int i = 0; i < 8; i++) {
        // 变换到裁剪空间 (Clip Space)
        vec4 clipSpacePos = projection * view * vec4(vertices[i], 1.0);

        // 归一化设备坐标 (NDC) 变换
        // 乘以 0.5 + 0.5 是为了将 NDC 的 [-1, 1] 映射到屏幕 UV 的 [0, 1] 空间
        vec3 ndcPos = clipSpacePos.xyz / clipSpacePos.w;
        vec2 uv = ndcPos.xy * 0.5 + vec2(0.5);

        // 裁剪保护：防止物体出屏或在相机背面时造成 UV 严重畸变
        uv = clamp(uv, vec2(0.0), vec2(1.0));

        // 迭代更新屏幕 AABB 的边界
        minUV = min(minUV, uv);
        maxUV = max(maxUV, uv);
        boxClosestDepth = max(boxClosestDepth, ndcPos.z);
        // 上面用的是 max 是因为  反转了 z 轴
    }

    // 4. 组合成上一个函数 sampleHZB 需要的 vec4 (aabbUV)
    // 映射关系：x=min_u, y=min_v, z=max_u, w=max_v
    return vec4(minUV.x, minUV.y, maxUV.x, maxUV.y);
}





bool hiz_cull(sampler2D uHiZDepth, hiz_cull_para frustum, vec2 view_range_x, vec2 view_range_y, float closest_z)
{
    // Viewport scale first applies any projection scale in X/Y (without Y flip).
    // The scale also does viewport size / 2 and then offsets into integer window coordinates.
    //    vec2 range_x = view_range_x * frustum.viewport_scale_bias.x + frustum.viewport_scale_bias.z;
    //    vec2 range_y = view_range_y * frustum.viewport_scale_bias.y + frustum.viewport_scale_bias.w;
    vec2 range_x = view_range_x;
    vec2 range_y = view_range_y;

    ivec2 ix = ivec2(range_x);
    ivec2 iy = ivec2(range_y);

    ivec2 image_size = textureSize(uHiZDepth, 0);

    ix.x = clamp(ix.x, 0, image_size.x - 1);
    ix.y = clamp(ix.y, ix.x, image_size.x - 1);
    iy.x = clamp(iy.x, 0, image_size.y - 1);
    iy.y = clamp(iy.y, iy.x, image_size.y - 1);

    // We need to sample from a LOD where there is at most one texel delta
    // between lo/hi values.
    int max_delta = max(ix.y - ix.x, iy.y - iy.x);
    int lod = clamp(findMSB(max_delta - 1) + 1, int(frustum.hiz_min_lod), int(frustum.hiz_max_lod));
    ivec2 lod_max_coord = max(image_size >> lod, ivec2(1)) - 1;
    ix = min(ix >> lod, lod_max_coord.xx);
    iy = min(iy >> lod, lod_max_coord.yy);

    ivec2 hiz_coord = ivec2(ix.x, iy.x);

    // We didn't write the top LOD.
    lod -= int(frustum.hiz_min_lod);

    float d = texelFetch(uHiZDepth, hiz_coord, lod).x;
    bool nx = ix.y != ix.x;
    bool ny = iy.y != iy.x;
    if (nx)
    d = min(d, texelFetchOffset(uHiZDepth, hiz_coord, lod, ivec2(1, 0)).x);
    if (ny)
    d = min(d, texelFetchOffset(uHiZDepth, hiz_coord, lod, ivec2(0, 1)).x);
    if (nx && ny)
    d = min(d, texelFetchOffset(uHiZDepth, hiz_coord, lod, ivec2(1, 1)).x);

    //  closest_z 是 物体的 最大的 一个点 , 也就是离屏幕最近的一个点
    //  d 是 深度图 中距离包围盒 最远的一个点
    //  closest_z 更大, 意味着会被绘制出来
    return closest_z > d;
}


layout (set = 2, binding = 0) uniform sampler2D input_texture;


layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main()
{
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= push_constant.command_size) {
        return;
    }
    AABB_boxes AABB_boxes_buffer = AABB_boxes(push_constant.AABB_boxesAddress);
    IndirectCommands command_buffer = IndirectCommands(push_constant.IndirectCommandsAddress);
    bool result = IsAABBInFrustum(push_constant.frustum, AABB_boxes_buffer.aabb_box[idx]);
    if (result == true) {
        //        uint write_index = atomicAdd(draw_count, 1);
        // // 利用这个独一无二的索引，紧密无缝地写入输出数组
        float boxClosestDepth;
        vec4 view_range = getScreenAABBUV(AABB_boxes_buffer.aabb_box[idx], boxClosestDepth);
        result = hiz_cull(input_texture, push_constant.para, view_range.xy, view_range.zw, boxClosestDepth);
        if (result == true) {
            command_buffer.command[idx].instanceCount = 1;
        }
    } else {
        command_buffer.command[idx].instanceCount = 0;
    }
}