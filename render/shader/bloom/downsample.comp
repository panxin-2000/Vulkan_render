#version 430 core

// 8x8 的二维线程块
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D InputTexture; // 较高分辨率的输入
layout(binding = 1, rgba32f) uniform writeonly image2D OutputImage; // 减半分辨率的输出

void main()
{
    ivec2 outTexSize = imageSize(OutputImage);
    ivec2 outCoord = ivec2(gl_GlobalInvocationID.xy);

    if (outCoord.x >= outTexSize.x || outCoord.y >= outTexSize.y)
    return;

    // 计算当前输出像素在输入纹理中对应的归一化 UV 坐标
    vec2 texelSize = 1.0 / vec2(textureSize(InputTexture, 0));
    vec2 uv = (vec2(outCoord) + vec2(0.5)) * 2.0 * texelSize;

    float x = texelSize.x;
    float y = texelSize.y;

    // 执行 13-tap 采样，利用硬件双线性插值获取平滑的下采样结果
    vec3 a = texture(InputTexture, uv + vec2(-2*x,  2*y)).rgb;
    vec3 b = texture(InputTexture, uv + vec2(   0,  2*y)).rgb;
    vec3 c = texture(InputTexture, uv + vec2( 2*x,  2*y)).rgb;
    vec3 d = texture(InputTexture, uv + vec2(-2*x,    0)).rgb;
    vec3 e = texture(InputTexture, uv + vec2(   0,    0)).rgb;
    vec3 f = texture(InputTexture, uv + vec2( 2*x,    0)).rgb;
    vec3 g = texture(InputTexture, uv + vec2(-2*x, -2*y)).rgb;
    vec3 h = texture(InputTexture, uv + vec2(   0, -2*y)).rgb;
    vec3 i = texture(InputTexture, uv + vec2( 2*x, -2*y)).rgb;
    vec3 j = texture(InputTexture, uv + vec2(  -x,    y)).rgb;
    vec3 k = texture(InputTexture, uv + vec2(   x,    y)).rgb;
    vec3 l = texture(InputTexture, uv + vec2(  -x,   -y)).rgb;
    vec3 m = texture(InputTexture, uv + vec2(   x,   -y)).rgb;

    // 形状更接近圆形扩散。它通过中、外层正方形的错位叠加，打破了正方形的边界感。
    // 放大回屏幕时，光晕（Glow/Glint）是完美的圆形渐变扩散

    // 经典 13-tap 加权平均系数
    vec3 result = e * 0.125;
    result += (a + c + g + i) * 0.03125;
    result += (b + d + f + h) * 0.0625;
    result += (j + k + l + m) * 0.125;

    imageStore(OutputImage, outCoord, vec4(result, 1.0));
}
