float hashNoise(vec2 fragCoord) {
    uvec2 p = uvec2(fragCoord);
    uint h = (p.x * 1597334673U) ^ (p.y * 3812015827U);
    h = h * 1597334673U;
    return float(h) * (1.0 / 4294967296.0);
}


