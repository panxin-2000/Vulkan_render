float hashNoise(vec2 fragCoord) {
    uvec2 p = uvec2(fragCoord);
    uint h = (p.x * 1597334673U) ^ (p.y * 3812015827U);
    h = h * 1597334673U;
    return float(h) * (1.0 / 4294967296.0);
}


#include "saoImpl.glsl"



layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;


void main()
{


    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;

    // 以 global_SSAO 为输出, 以输出 的 大小,转换出应该采样的 UV
    ivec2 image_size = imageSize(output_texture);
    uint width = uint(image_size.x);
    uint height = uint(image_size.y);
    // 越界检查
    if (x >= width || y >= height) {
        return;
    }
    ivec2 pixelCoord = ivec2(x, y); // imageStore 使用 2D 向量作为坐标
    ivec2 pixel_coords = ivec2(gl_GlobalInvocationID.xy);
    vec2 inUV = (vec2(pixel_coords) + 0.5) / image_size;


    // 首先,这里 拿到的深度值 是已经经过反转 z 轴的 0~1 的,
    // 那么结果就是 1 是离的很近, 0 是离的很远
    highp float depth = sampleDepth(input_depth_texture, inUV, 0.0);
    vec3 origin = get_view_pos(inUV, depth, invProjection);
    //  origin 中的 拿到的 z 轴是负数,  首先这里是哪里? 在 相机空间中的 位置
    // x y 两个轴是 正常的
    // X轴向右，Y轴向上）时，Z 轴会指向屏幕外面（指向观察者）
    // 所以 拿到的  origin 中的 拿到的 z 轴是负数

    vec2 depth_tex_size = textureSize(input_depth_texture, 0);

    vec3 normal = computeViewSpaceNormalHighQ(input_depth_texture, inUV, origin.z, origin, 1 / depth_tex_size,
            invProjection);

    float occlusion = 0.0;
    vec3 bentNormal; // will be discarded

    scalableAmbientObscurance(occlusion, bentNormal, inUV, origin, normal, pixel_coords, projection, invProjection, input_depth_texture);

    float aoVisibility = pow(saturate(1.0 - occlusion), materialParams.power);

    imageStore(output_texture, pixel_coords, vec4(aoVisibility, pack(depth), 0.0));
}

//  简单的描述 ,采样的 过程需要完成什么?
// 首先我需要去拿到 当前屏幕坐标对应的  相机空间中的位置 和  不知道什么空间中的 法线
// 因为 是判断几何遮挡的 情况,
// 所以 需要 从 相机空间中的位置 向 四周发射 射线, 检查 周围是否存在 遮挡
// 知道这个点的 法线的 方向, 那么能向 半球空间 检查 是否遮挡
// 需要循环采样
//     确定需要 检查的 半球上的每个点
//     得到需要采样的 点的 UV 坐标, 或者说, 射线行走固定距离后的 UV 的坐标在哪里
//     得到 UV 坐标上的 深度
//     比较 半球上的 点 深度 与 贴图上的 深度
//     数量越多, 遮挡的越多
// 最后 再 决定是否需要执行一个 1- rusult 作为最终的输出
// 保存结果到图片中
