// 上面就是需要的全部的参数了
//type : sampler2d,
//name : depth,
//precision: high,
//filterable: false //


highp vec3 computeViewSpaceNormalHighQ_temp(
        const highp sampler2D depthTexture, const highp vec2 uv,
        const highp float depth, const highp vec3 position,
        highp vec2 texel, highp mat4 invProjection) {
    precision highp
    float;

    vec3 pos_c = position;
    highp vec2 dx = vec2(texel.x, 0.0);
    highp vec2 dy = vec2(0.0, texel.y);

    vec4 H;
    H.x = sampleDepth(depthTexture, uv - dx, 0.0);
    H.y = sampleDepth(depthTexture, uv + dx, 0.0);
    H.z = sampleDepth(depthTexture, uv - dx * 2.0, 0.0);
    H.w = sampleDepth(depthTexture, uv + dx * 2.0, 0.0);
    vec2 he = abs((2.0 * H.xy - H.zw) - depth);
    vec3 pos_l = get_view_pos(uv - dx, (H.x), invProjection);
    vec3 pos_r = get_view_pos(uv + dx, (H.y), invProjection);
    vec3 dpdx = (he.x < he.y) ? (pos_c - pos_l) : (pos_r - pos_c);

    vec4 V;
    V.x = sampleDepth(depthTexture, uv - dy, 0.0);
    V.y = sampleDepth(depthTexture, uv + dy, 0.0);
    V.z = sampleDepth(depthTexture, uv - dy * 2.0, 0.0);
    V.w = sampleDepth(depthTexture, uv + dy * 2.0, 0.0);
    vec2 ve = abs((2.0 * V.xy - V.zw) - depth);
    vec3 pos_d = get_view_pos(uv - dy, (V.x), invProjection);
    vec3 pos_u = get_view_pos(uv + dy, (V.y), invProjection);
    vec3 dpdy = (ve.x < ve.y) ? (pos_c - pos_d) : (pos_u - pos_c);

    return normalize(cross(dpdy, dpdx));
}

layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;


void main()
{


    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;

    // 以 global_SSAO 为输出, 以输出 的 大小,转换出应该采样的 UV
    ivec2 image_size = imageSize(output_texture);
    uint width = uint(image_size.x);
    uint height = uint(image_size.y);
    // 越界检查
    if (x >= width || y >= height) {
        return;
    }
    ivec2 pixelCoord = ivec2(x, y); // imageStore 使用 2D 向量作为坐标
    ivec2 pixel_coords = ivec2(gl_GlobalInvocationID.xy);
    vec2 inUV = (vec2(pixel_coords) + 0.5) / image_size;


    // 首先,这里 拿到的深度值 是已经经过反转 z 轴的 0~1 的,
    // 那么结果就是 1 是离的很近, 0 是离的很远
    highp float depth = sampleDepth(input_depth_texture, inUV, 0.0);
    vec3 viewPos = get_view_pos(inUV, depth, invProjection);
    //  origin 中的 拿到的 z 轴是负数,  首先这里是哪里? 在 相机空间中的 位置
    // x y 两个轴是 正常的
    // X轴向右，Y轴向上）时，Z 轴会指向屏幕外面（指向观察者）
    // 所以 拿到的  origin 中的 拿到的 z 轴是负数

    vec2 depth_tex_size = textureSize(input_depth_texture, 0);

    vec3 normal = computeViewSpaceNormalHighQ_temp(input_depth_texture, inUV, viewPos.z, viewPos, 1 / depth_tex_size,
            invProjection);

    float noise = hashNoise(pixel_coords.xy);
    float angle = noise * 2.0 * 3.1415926535f; // 映射到 0 到 360 度
    vec3 randomVec = vec3(cos(angle), sin(angle), 0.0); // 完美的二维随机切线


    // Create TBN matrix
    vec3 tangent = normalize(randomVec - normal * dot(randomVec, normal));
    vec3 bitangent = cross(tangent, normal);
    mat3 TBN = mat3(tangent, bitangent, normal);

    // Calculate occlusion value
    float occlusion = 0.0f;
    // remove banding
    const float bias = 0.025f;
    for (int i = 0; i < SSAO_KERNEL_SIZE; i++)
    {
        vec3 samplePos = TBN * SSAO_KERNEL[i];
        samplePos = viewPos + samplePos * SSAO_RADIUS;
        float level = clamp(floor(log2(SSAO_RADIUS)) - 3.0, 0.0, float(materialParams.maxLevel));


        // project
        vec4 offset = vec4(samplePos, 1.0f);
        offset = projection * offset;
        offset.xyz /= offset.w;
        offset.xyz = offset.xyz * 0.5f + 0.5f;

        highp float depth_temp = sampleDepth(input_depth_texture, offset.xy, level);

        vec3 sampleDepth = get_view_pos(offset.xy, depth_temp, invProjection);


        float rangeCheck = smoothstep(0.0f, 1.0f, SSAO_RADIUS / abs(viewPos.z - sampleDepth.z));
        occlusion += (sampleDepth.z >= samplePos.z + bias ? 1.0f : 0.0f) * rangeCheck;
    }
    occlusion = 1.0 - (occlusion / float(SSAO_KERNEL_SIZE));

    imageStore(output_texture, pixel_coords, vec4(occlusion, 0.0, 0.0, 0.0)); // 纯红
}

//  简单的描述 ,采样的 过程需要完成什么?
// 首先我需要去拿到 当前屏幕坐标对应的  相机空间中的位置 和  不知道什么空间中的 法线
// 因为 是判断几何遮挡的 情况,
// 所以 需要 从 相机空间中的位置 向 四周发射 射线, 检查 周围是否存在 遮挡
// 知道这个点的 法线的 方向, 那么能向 半球空间 检查 是否遮挡
// 需要循环采样
//     确定需要 检查的 半球上的每个点
//     得到需要采样的 点的 UV 坐标, 或者说, 射线行走固定距离后的 UV 的坐标在哪里
//     得到 UV 坐标上的 深度
//     比较 半球上的 点 深度 与 贴图上的 深度
//     数量越多, 遮挡的越多
// 最后 再 决定是否需要执行一个 1- rusult 作为最终的输出
// 保存结果到图片中
