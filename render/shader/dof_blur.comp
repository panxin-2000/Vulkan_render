#version 450 core

// 以 16x16 的局部工作组（Workgroup）为单位处理像素
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;


#define GOLDEN_ANGLE 2.39996323 // 黄金角度（弧度制），用于构建完美的圆形光圈焦外 (Bokeh)
#define MAX_SAMPLES 24          // 采样次数，Compute Shader 下由于高速缓存机制，24次即可获得极高画质

#extension GL_GOOGLE_include_directive: enable
#include "global_shader_common.glsl"



void main() {
    ivec2 texelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imgSize = imageSize(global_dof_BlurImg).xy;
    if (texelCoord.x >= imgSize.x || texelCoord.y >= imgSize.y) return;
    vec2 inUV = (vec2(texelCoord) + 0.5) / imgSize;
    float z = textureLod(global_depth, (inUV), 0).r;
    float currentDepth = abs(get_view_pos(inUV, z, invProjection).z);
    vec2 focus_UV = mouse_position.xy / imgSize;
    float focus_z = textureLod(global_depth, (focus_UV), 0).r;
    float focus_Depth = abs(get_view_pos(focus_UV, focus_z, invProjection).z);
    float cocRadius = abs(currentDepth - focus_Depth) / currentDepth *
    (focalLength * focalLength / (aperture * (focus_Depth - focalLength)));
    float cocInPixels = (cocRadius * screen_size.x / sensorWidthMeters);
    vec4 sharpColor = texelFetch(global_offscreen, texelCoord, 0);
    if (cocInPixels < 0.5) {
        imageStore(global_dof_BlurImg, texelCoord, vec4(sharpColor.xyz, 0));
        return;
    }
    float finalAlphaCoC = clamp(cocInPixels / MaxBlurPixels, 0.0, 1.0);
    float currentRadius = min(cocInPixels, MaxBlurPixels);
    vec3 colorSum = vec3(0.0);
    float weightSum = 0.0;
    for (int i = 0; i < MAX_SAMPLES; i++) {
        // 随着循环，采样点沿螺旋向外扩散
        float r = sqrt(float(i + 0.5)) / sqrt(float(MAX_SAMPLES));
        float theta = float(i) * GOLDEN_ANGLE;
        ivec2 offset = ivec2(cos(theta) * r * currentRadius, sin(theta) * r * currentRadius);
        ivec2 sampleCoord = clamp(texelCoord + offset, ivec2(0), imgSize - ivec2(1));
        vec3 sampleColor = texelFetch(global_offscreen, sampleCoord, 0).rgb;
        vec2 sample_depth_UV = (vec2(sampleCoord) + 0.5) / imgSize;
        float sample_z = textureLod(global_depth, (sample_depth_UV), 0).r;
        float sampleDepth = abs(get_view_pos(sample_depth_UV, sample_z, invProjection).z);
        float weight = 1.0;
        if (sampleDepth < currentDepth && finalAlphaCoC < 0.3) {
            weight = 0.1;
        }
        colorSum += sampleColor * weight;
        weightSum += weight;
    }
    // 4. 将模糊后的 RGB 结果输出，并将当前像素的 CoC 写入 Alpha 通道留给 Pass 2 使用
    vec3 finalBlurColor = colorSum / max(weightSum, 0.0001);
    vec3 finalBlendedColor = mix(sharpColor.rgb, finalBlurColor, finalAlphaCoC);
    imageStore(global_dof_BlurImg, texelCoord, vec4(finalBlendedColor, 1.0));
}
