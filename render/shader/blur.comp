#version 450
precision highp float;


layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout (set = 0, binding = 0) uniform sampler2D input_texture;
layout (r8, set = 0, binding = 1) uniform image2D output_texture;

#define METHOD_3TAP_GAUSS_HORIZ 0
#define METHOD_5TAP_GAUSS_HORIZ 1
#define METHOD_7TAP_GAUSS_HORIZ 2
#define METHOD_3TAP_GAUSS_VERT 3
#define METHOD_5TAP_GAUSS_VERT 4
#define METHOD_7TAP_GAUSS_VERT 5
#define METHOD_3x3_TAP_GAUSS 6
#define METHOD_3x3_TAP_GAUSS_4_time 7
#define METHOD_5x5_TAP_GAUSS 8
#define METHOD_5x5_TAP_GAUSS_9_time 8

#ifndef METHOD
#define METHOD METHOD_3x3_TAP_GAUSS_4_time
#endif

void main()
{
    ivec2 pixel_coords = ivec2(gl_GlobalInvocationID.xy);
    ivec2 texSize = imageSize(output_texture); // 一张超小的 2 × 2 像素贴图  返回值：一定是 ivec2(2, 2)
    if (gl_GlobalInvocationID.x >= texSize.x || gl_GlobalInvocationID.y >= texSize.y) {
        return;
    }
    vec2 baseUV = (vec2(pixel_coords) + 0.5) / texSize;

    vec4 color = vec4(0.0);
    #if METHOD == METHOD_3TAP_GAUSS_HORIZ
    const float w0 = 0.25;
    const float w1 = 0.5;
    color += textureLodOffset(input_texture, baseUV, 0.0, ivec2(-1, 0)) * w0;
    color += textureLod(input_texture, baseUV, 0.0) * w1;
    color += textureLodOffset(input_texture, baseUV, 0.0, ivec2(+1, 0)) * w0;
    #elif METHOD == METHOD_5TAP_GAUSS_HORIZ
    const float w0 = 0.07142857;
    const float w1 = 0.14285;
    const float w2 = 0.285714;
    const float weight = 1.0 / (w2 + w1 * 2.0 + w0 * 2.0);
    const float W0 = w0 * weight;
    const float W1 = w1 * weight;
    const float W2 = w2 * weight;
    color += textureLodOffset(input_texture, baseUV, 0.0, ivec2(-2, 0)) * W0;
    color += textureLodOffset(input_texture, baseUV, 0.0, ivec2(-1, 0)) * W1;
    color += textureLod(input_texture, baseUV, 0.0) * W2;
    color += textureLodOffset(input_texture, baseUV, 0.0, ivec2(+1, 0)) * W1;
    color += textureLodOffset(input_texture, baseUV, 0.0, ivec2(+2, 0)) * W0;
    #elif METHOD == METHOD_7TAP_GAUSS_HORIZ
    const float w0 = 0.03007964045641579;
    const float w1 = 0.10496581333665146;
    const float w2 = 0.22226040083356216;
    const float w3 = 0.2853882907467413;
    color += textureLodOffset(input_texture, baseUV, 0.0, ivec2(-3, 0)) * w0;
    color += textureLodOffset(input_texture, baseUV, 0.0, ivec2(-2, 0)) * w1;
    color += textureLodOffset(input_texture, baseUV, 0.0, ivec2(-1, 0)) * w2;
    color += textureLod(input_texture, baseUV, 0.0) * w3;
    color += textureLodOffset(input_texture, baseUV, 0.0, ivec2(+1, 0)) * w2;
    color += textureLodOffset(input_texture, baseUV, 0.0, ivec2(+2, 0)) * w1;
    color += textureLodOffset(input_texture, baseUV, 0.0, ivec2(+3, 0)) * w0;
    #elif METHOD == METHOD_3TAP_GAUSS_VERT
    const float w0 = 0.25;
    const float w1 = 0.5;
    color += textureLodOffset(input_texture, baseUV, 0.0, ivec2(0, -1)) * w0;
    color += textureLod(input_texture, baseUV, 0.0) * w1;
    color += textureLodOffset(input_texture, baseUV, 0.0, ivec2(0, +1)) * w0;
    #elif METHOD == METHOD_5TAP_GAUSS_VERT
    const float w0 = 0.07142857;
    const float w1 = 0.14285;
    const float w2 = 0.285714;
    const float weight = 1.0 / (w2 + w1 * 2.0 + w0 * 2.0);
    const float W0 = w0 * weight;
    const float W1 = w1 * weight;
    const float W2 = w2 * weight;
    color += textureLodOffset(input_texture, baseUV, 0.0, ivec2(0, -2)) * W0;
    color += textureLodOffset(input_texture, baseUV, 0.0, ivec2(0, -1)) * W1;
    color += textureLod(input_texture, baseUV, 0.0) * W2;
    color += textureLodOffset(input_texture, baseUV, 0.0, ivec2(0, +1)) * W1;
    color += textureLodOffset(input_texture, baseUV, 0.0, ivec2(0, +2)) * W0;
    #elif METHOD == METHOD_7TAP_GAUSS_VERT
    const float w0 = 0.03007964045641579;
    const float w1 = 0.10496581333665146;
    const float w2 = 0.22226040083356216;
    const float w3 = 0.2853882907467413;
    color += textureLodOffset(input_texture, baseUV, 0.0, ivec2(0, -3)) * w0;
    color += textureLodOffset(input_texture, baseUV, 0.0, ivec2(0, -2)) * w1;
    color += textureLodOffset(input_texture, baseUV, 0.0, ivec2(0, -1)) * w2;
    color += textureLod(input_texture, baseUV, 0.0) * w3;
    color += textureLodOffset(input_texture, baseUV, 0.0, ivec2(0, +1)) * w2;
    color += textureLodOffset(input_texture, baseUV, 0.0, ivec2(0, +2)) * w1;
    color += textureLodOffset(input_texture, baseUV, 0.0, ivec2(0, +3)) * w0;
    #elif METHOD == METHOD_3x3_TAP_GAUSS  // TAP 是采样的意思

    const float w00 = 0.0625;     const float w01 = 0.125;    const float w02 = 0.0625;
    const float w10 = 0.125;      const float w11 = 0.25;     const float w12 = 0.125;
    const float w20 = 0.0625;     const float w21 = 0.125;    const float w22 = 0.0625;

    const ivec2 uv_00 = ivec2(-1, -1);     const ivec2 uv_01 = ivec2(+0, -1);    const ivec2 uv_02 = ivec2(+1, -1);
    const ivec2 uv_10 = ivec2(-1, +0);     const ivec2 uv_11 = ivec2(0, +0);     const ivec2 uv_12 = ivec2(+1, +0);
    const ivec2 uv_20 = ivec2(-1, +1);     const ivec2 uv_21 = ivec2(+0, +1);    const ivec2 uv_22 = ivec2(+1, +1);
    //  1  2  1        //  1/16  2/16  1/16     //  0.0625  0.125  0.0625
    //  2  4  2 -> 16  //  2/16  4/16  2/16  -> //  0.125   0.25   0.125
    //  1  2  1        //  1/16  2/16  1/16     //  0.0625  0.125  0.0625
    color += textureLodOffset(input_texture, baseUV, 0.0, uv_00) * w00;
    color += textureLodOffset(input_texture, baseUV, 0.0, uv_10) * w10;
    color += textureLodOffset(input_texture, baseUV, 0.0, uv_20) * w20;
    color += textureLodOffset(input_texture, baseUV, 0.0, uv_01) * w01;
    color += textureLodOffset(input_texture, baseUV, 0.0, uv_11) * w11;
    color += textureLodOffset(input_texture, baseUV, 0.0, uv_21) * w21;
    color += textureLodOffset(input_texture, baseUV, 0.0, uv_02) * w02;
    color += textureLodOffset(input_texture, baseUV, 0.0, uv_12) * w12;
    color += textureLodOffset(input_texture, baseUV, 0.0, uv_22) * w22;

    #elif METHOD == METHOD_3x3_TAP_GAUSS_4_time

    //  1  2  1        //  1/16  2/16  1/16     //  0.0625  0.125  0.0625
    //  2  4  2 -> 16  //  2/16  4/16  2/16  -> //  0.125   0.25   0.125
    //  1  2  1        //  1/16  2/16  1/16     //  0.0625  0.125  0.0625

    //  A  B  C            //  A  B          //     B     C      //                  //
    //  D  E  F  -> 4次采样 //  D  E          //     E     F      //    D   E         //     E    F
    //  G  H  I            //                //                  //    G   H         //     H    I

    //  A  B  C            //  0.25  0.25    //     0.25  0.25   //                  //
    //  D  E  F  -> 4次采样 //  0.25  0.25    //     0.25  0.25   //  0.25  0.25      //     0.25  0.25
    //  G  H  I            //                //                  //  0.25  0.25      //     0.25  0.25

    //  A  B  C            //  0.25  0.25    //     0.25  0.25   //                  //
    //  D  E  F  -> 4次采样 //  0.25  0.25    //     0.25  0.25   //  0.25  0.25      //     0.25  0.25
    //  G  H  I            //                //                  //  0.25  0.25      //     0.25  0.25

    //  A  B  C            //  0.0625  0.0625  0  //  0  0.0625  0.0625   //  0       0       0  // 0   0       0
    //  D  E  F  -> 4次采样 //  0.0625  0.0625  0  //  0  0.0625  0.0625   //  0.0625  0.0625  0  // 0   0.0625  0.0625
    //  G  H  I            //  0       0       0  //  0  0       0        //  0.0625  0.0625  0  // 0   0.0625  0.0625

    //  A*1   B*2   C*1    //  0.0625  0.125  0.0625
    //  D*2   E*4   F*2    //  0.125   0.25   0.125
    //  G*1   H*2   I*1    //  0.0625  0.125  0.0625

    vec2 inTexSize = vec2(textureSize(input_texture, 0));
    vec2 invInputSize = 1.0 / inTexSize;
    const float offset = 0.5;
    const float weight = 0.25;

    color += textureLod(input_texture, baseUV + vec2(-offset, -offset) * invInputSize, 0.0) * weight;
    color += textureLod(input_texture, baseUV + vec2(+offset, -offset) * invInputSize, 0.0) * weight;
    color += textureLod(input_texture, baseUV + vec2(-offset, +offset) * invInputSize, 0.0) * weight;
    color += textureLod(input_texture, baseUV + vec2(+offset, +offset) * invInputSize, 0.0) * weight;

    #elif METHOD == METHOD_5x5_TAP_GAUSS


    // 标准 5x5 高斯矩阵分布 (总和 256):
    //  1   4   6   4   1
    //  4  16  24  16   4
    //  6  24  36  24   6
    //  4  16  24  16   4
    //  1   4   6   4   1

    // ==========================================
    // 1. 25 次采样的归一化权重常量 (除以 256.0)
    // ==========================================
    const float w00 = 1.0 / 256.0;   const float w01 = 4.0 / 256.0;   const float w02 = 6.0 / 256.0;   const float w03 = 4.0 / 256.0;   const float w04 = 1.0 / 256.0;
    const float w10 = 4.0 / 256.0;   const float w11 = 16.0 / 256.0;  const float w12 = 24.0 / 256.0;  const float w13 = 16.0 / 256.0;  const float w14 = 4.0 / 256.0;
    const float w20 = 6.0 / 256.0;   const float w21 = 24.0 / 256.0;  const float w22 = 36.0 / 256.0;  const float w23 = 24.0 / 256.0;  const float w24 = 6.0 / 256.0;
    const float w30 = 4.0 / 256.0;   const float w31 = 16.0 / 256.0;  const float w32 = 24.0 / 256.0;  const float w33 = 16.0 / 256.0;  const float w34 = 4.0 / 256.0;
    const float w40 = 1.0 / 256.0;   const float w41 = 4.0 / 256.0;   const float w42 = 6.0 / 256.0;   const float w43 = 4.0 / 256.0;   const float w44 = 1.0 / 256.0;

    // ==========================================
    // 2. 25 个像素网格的整型偏移量 (ivec2)
    // ==========================================
    const ivec2 uv_00 = ivec2(-2, -2); const ivec2 uv_01 = ivec2(-1, -2); const ivec2 uv_02 = ivec2(0, -2); const ivec2 uv_03 = ivec2(1, -2); const ivec2 uv_04 = ivec2(2, -2);
    const ivec2 uv_10 = ivec2(-2, -1); const ivec2 uv_11 = ivec2(-1, -1); const ivec2 uv_12 = ivec2(0, -1); const ivec2 uv_13 = ivec2(1, -1); const ivec2 uv_14 = ivec2(2, -1);
    const ivec2 uv_20 = ivec2(-2, 0);  const ivec2 uv_21 = ivec2(-1, 0);  const ivec2 uv_22 = ivec2(0, 0);  const ivec2 uv_23 = ivec2(1, 0);  const ivec2 uv_24 = ivec2(2, 0);
    const ivec2 uv_30 = ivec2(-2, 1);  const ivec2 uv_31 = ivec2(-1, 1);  const ivec2 uv_32 = ivec2(0, 1);  const ivec2 uv_33 = ivec2(1, 1);  const ivec2 uv_34 = ivec2(2, 1);
    const ivec2 uv_40 = ivec2(-2, 2);  const ivec2 uv_41 = ivec2(-1, 2);  const ivec2 uv_42 = ivec2(0, 2);  const ivec2 uv_43 = ivec2(1, 2);  const ivec2 uv_44 = ivec2(2, 2);

    // ==========================================
    // 3. 暴力执行 25 次硬件纹理采样并叠加
    // ==========================================
    // 第 0 行
    color += textureLodOffset(input_texture, baseUV, 0.0, uv_00) * w00;
    color += textureLodOffset(input_texture, baseUV, 0.0, uv_01) * w01;
    color += textureLodOffset(input_texture, baseUV, 0.0, uv_02) * w02;
    color += textureLodOffset(input_texture, baseUV, 0.0, uv_03) * w03;
    color += textureLodOffset(input_texture, baseUV, 0.0, uv_04) * w04;

    // 第 1 行
    color += textureLodOffset(input_texture, baseUV, 0.0, uv_10) * w10;
    color += textureLodOffset(input_texture, baseUV, 0.0, uv_11) * w11;
    color += textureLodOffset(input_texture, baseUV, 0.0, uv_12) * w12;
    color += textureLodOffset(input_texture, baseUV, 0.0, uv_13) * w13;
    color += textureLodOffset(input_texture, baseUV, 0.0, uv_14) * w14;

    // 第 2 行 (中心行)
    color += textureLodOffset(input_texture, baseUV, 0.0, uv_20) * w20;
    color += textureLodOffset(input_texture, baseUV, 0.0, uv_21) * w21;
    color += textureLodOffset(input_texture, baseUV, 0.0, uv_22) * w22; // 真正的中心像素
    color += textureLodOffset(input_texture, baseUV, 0.0, uv_23) * w23;
    color += textureLodOffset(input_texture, baseUV, 0.0, uv_24) * w24;

    // 第 3 行
    color += textureLodOffset(input_texture, baseUV, 0.0, uv_30) * w30;
    color += textureLodOffset(input_texture, baseUV, 0.0, uv_31) * w31;
    color += textureLodOffset(input_texture, baseUV, 0.0, uv_32) * w32;
    color += textureLodOffset(input_texture, baseUV, 0.0, uv_33) * w33;
    color += textureLodOffset(input_texture, baseUV, 0.0, uv_34) * w34;

    // 第 4 行
    color += textureLodOffset(input_texture, baseUV, 0.0, uv_40) * w40;
    color += textureLodOffset(input_texture, baseUV, 0.0, uv_41) * w41;
    color += textureLodOffset(input_texture, baseUV, 0.0, uv_42) * w42;
    color += textureLodOffset(input_texture, baseUV, 0.0, uv_43) * w43;
    color += textureLodOffset(input_texture, baseUV, 0.0, uv_44) * w44;

    #elif METHOD == METHOD_5x5_TAP_GAUSS_9_time

    // [ 1   4 ]   6  [ 4   1 ]   //   1   4   [ 6 ]     4   1      //  1   4   6   4   1
    // [ 4  16 ]  24  [ 16  4 ]   //   4  16   [ 24 ]   16   4      //  4  16  24  16   4
    //   6  24    36    24   6    // [ 6  24 ]   36   [ 24   6 ]    //  6  24  [36]  24   6
    // [ 4  16 ]  24  [ 16   4 ]  //   4  16   [ 24 ]   16   4      //  4  16  24  16   4
    // [ 1   4 ]   6  [ 4   1 ]   //   1   4   [ 6 ]     4   1      //  1   4   6   4   1

    #endif
    imageStore(output_texture, pixel_coords, color);
}
