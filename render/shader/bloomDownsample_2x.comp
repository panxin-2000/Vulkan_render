#version 450
// 建议使用 16x16 线程组，可根据目标硬件进行优化
layout(local_size_x = 16, local_size_y = 16) in;

// --- 对应原本的材质 parameters 声明 ---
layout(binding = 0) uniform sampler2D materialParams_source;

layout(std140, binding = 1) uniform MaterialParams {
    float level;
    float threshold;
    float fireflies;
    float invHighlight;
} materialParams;

// 目标输出图像
layout(rgba16f, binding = 2) writeonly uniform image2D out_texture;

// --- 辅助函数：找出 vec3 中三个分量的最大值 ---
highp float max3(vec3 v) {
    return max(v.x, max(v.y, v.z));
}


//觉得画面辉光（Bloom）连成死白一片，缺乏细节：尝试增大该值（例如从 0.1 调到 0.3）
//觉得画面太闷，高光不够亮、没有冲击力：尝试减小该值（例如从 0.1 调到 0.02）
void threshold(inout vec3 c, float invHighlight) {
    // 过滤掉所有亮度低于 1.0 的部分
    c = max(vec3(0.0), c - 1.0);

    // 压制所有高于 1.0 的高亮部分
    highp float f = max3(c);
    c *= 1.0 / (1.0 + f * invHighlight);
}

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;

    // 获取目标图像尺寸
    ivec2 texSize = imageSize(out_texture);
    uint width = uint(texSize.x);
    uint height = uint(texSize.y);

    // 越界检查
    if (x >= width || y >= height) {
        return;
    }

    // 【核心替换】将原本的 variable_vertex.xy 替换为当前像素中心的归一化 UV 坐标
    highp vec2 screenUV = (vec2(x, y) + vec2(0.5)) / vec2(width, height);

    float lod = materialParams.level;

    // 获取输入纹理在特定 Mip 级别的大小与纹素大小
    highp vec2 size = vec2(textureSize(materialParams_source, int(lod)));
    highp vec2 texelSize = vec2(1.0) / size;

    // Castaño, 2013, "Shadow Mapping Summary Part 1"
    // 3x3 gaussian filter with 4 linear samples
    vec2 offset = vec2(0.5);
    highp vec2 uv = (screenUV * size) + offset; // 使用算好的 screenUV 替换
    highp vec2 base = (floor(uv) - offset) * texelSize;
    highp vec2 st = fract(uv);

    vec2 uw = vec2(3.0 - 2.0 * st.x, 1.0 + 2.0 * st.x);
    vec2 vw = vec2(3.0 - 2.0 * st.y, 1.0 + 2.0 * st.y);

    highp vec2 u = vec2((2.0 - st.x) / uw.x - 1.0, st.x / uw.y + 1.0) * texelSize.x;
    highp vec2 v = vec2((2.0 - st.y) / vw.x - 1.0, st.y / vw.y + 1.0) * texelSize.y;

    // 执行 4 次硬件双线性采样
    vec3 c0 = textureLod(materialParams_source, base + vec2(u.x, v.x), lod).rgb;
    vec3 c1 = textureLod(materialParams_source, base + vec2(u.y, v.x), lod).rgb;
    vec3 c2 = textureLod(materialParams_source, base + vec2(u.x, v.y), lod).rgb;
    vec3 c3 = textureLod(materialParams_source, base + vec2(u.y, v.y), lod).rgb;

    // 计算各采样点的初始高斯混合权重
    float w0 = uw.x * vw.x * (1.0 / 16.0);
    float w1 = uw.y * vw.x * (1.0 / 16.0);
    float w2 = uw.x * vw.y * (1.0 / 16.0);
    float w3 = uw.y * vw.y * (1.0 / 16.0);

    // 抗萤火虫（Fireflies）逻辑：根据像素亮度动态削弱超亮噪点的权重
    if (materialParams.fireflies > 0.0) {
        w0 /= (1.0 + max3(c0));
        w1 /= (1.0 + max3(c1));
        w2 /= (1.0 + max3(c2));
        w3 /= (1.0 + max3(c3));

        // 重新归一化权重，确保它们相加依然等于 1.0
        float w = 1.0 / (w0 + w1 + w2 + w3);
        w0 *= w;
        w1 *= w;
        w2 *= w;
        w3 *= w;
    }

    // 加权混合得到最终颜色
    vec3 c = c0 * w0 + c1 * w1 + c2 * w2 + c3 * w3;

    // 满足阈值条件时执行高光压制
    if (materialParams.threshold > 0.0) {
        threshold(c, materialParams_source.invHighlight);
    }

    // 将计算好的降采样颜色写入目标纹理
    imageStore(out_texture, ivec2(x, y), vec4(c, 1.0));
}
